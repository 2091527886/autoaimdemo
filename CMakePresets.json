{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/master/Help/manual/presets/schema.json",
  "version": 8,
  "configurePresets": [
    {
      "name": "win-vs-debug",
      "displayName": "Windows-MSVC Debug (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "OpenCV_DIR": "${sourceDir}/opencv/build"
      }
    },
    {
      "name": "win-vs-release",
      "displayName": "Windows-MSVC Release (Visual Studio 2026)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "OpenCV_DIR": "${sourceDir}/opencv/build"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-vs-debug",
      "configurePreset": "win-vs-debug",
      "configuration": "Debug"
    },
    {
      "name": "win-vs-release",
      "configurePreset": "win-vs-release",
      "configuration": "Release"
    }
  ],
  "testPresets": []
}
